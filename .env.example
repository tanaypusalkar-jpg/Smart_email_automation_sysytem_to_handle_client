# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# --- SMTP (sending mail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Email Automation Bot

# --- IMAP (optional, not yet wired to an endpoint) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password

# --- Database (audit log of classify/compose/send activity) ---
DATABASE_URL=sqlite:///./app/data/emails.db

# --- Google OAuth (protects POST /emails/send) ---
# Leave blank to disable the auth check entirely (local dev / testing).
# Set both once you have real values from Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Rate limiting ---
RATE_LIMIT_SEND=5/minute
RATE_LIMIT_COMPOSE=20/minute

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
VECTOR_DB_PATH=./app/data/chroma_store

# Safety switch. true = /send never actually dispatches mail.
DRY_RUN=true
